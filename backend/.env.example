# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=21501

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# DB_HOST=localhost + DB_PORT=21503 -> for running the backend OUTSIDE Docker,
# against the port mapped to the host by docker-compose.override.yaml.
# Inside Docker Compose, DB_HOST is overridden to "db" and DB_PORT to 5432 —
# see the "environment:" block for the backend service in docker-compose.yaml.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=21503
DB_USER=change_me
DB_PASS=change_me_use_a_strong_password
DB_NAME=portail_db

# ---------------------------------------------------------------------------
# Lawyer authentication (JWT)
# Generate with: openssl rand -hex 32
# Must be DIFFERENT from DEPOSIT_SESSION_SECRET below — the two auth worlds
# (lawyer vs anonymous deposit session) must never share a signing secret.
# ---------------------------------------------------------------------------
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=1d

# ---------------------------------------------------------------------------
# Deposit session authentication (short-lived JWT issued after PIN unlock)
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
DEPOSIT_SESSION_SECRET=change_me_generate_a_different_secret_than_jwt
DEPOSIT_SESSION_EXPIRES_IN=30m

# ---------------------------------------------------------------------------
# Object storage (MinIO, S3-compatible)
# MINIO_ENDPOINT/MINIO_PORT: internal Docker network values ("minio"/9000)
# are set directly in docker-compose.yaml, not read from this file in
# production. The localhost/21506 values below are for running the backend
# OUTSIDE Docker, against the port mapped by docker-compose.override.yaml.
# MINIO_PUBLIC_URL: the PUBLIC domain used to sign download URLs — must be
# reachable by the end user's browser (routed through nginx), never the
# internal "minio:9000" hostname. See backend/README.md for why two
# separate S3 clients exist in StorageService.
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=21506
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me_use_a_strong_password
MINIO_BUCKET=lawyer-bucket
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=https://your-domain.example.com