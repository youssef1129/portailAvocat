# ---------------------------------------------------------------------------
# API base URL
# This is a BUILD-TIME variable, baked into the client bundle when the
# Docker image is built (passed as --build-arg NEXT_PUBLIC_API_URL=...).
# Changing it after the image is built has no effect — the image must be
# rebuilt. For local dev (npm run dev), it's read normally at runtime.
#
# Local dev (backend running outside Docker): http://localhost:21501
# Production: your public HTTPS domain, e.g. https://your-domain.example.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:21501