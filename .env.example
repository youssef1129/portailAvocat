# Deployment environment — copy to .env on the server and fill in secrets.
# Images are pulled from GHCR; never build backend/frontend on the deployment machine.

COMPOSE_PROJECT_NAME=portailavocat

# Public domain (used by Makefile certbot targets)
DOMAIN=youssef-maazouz.stage2-div.rayan-drissi.com
CERTBOT_EMAIL=your-email@example.com

# Database (internal Docker network only — never published to host)
DB_USER=PORTAIL_USER
DB_PASSWORD=change-me
DB_NAME=PORTAIL_DB

# Auth secrets — generate strong random values for production
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
DEPOSIT_SESSION_SECRET=change-me
DEPOSIT_SESSION_EXPIRES_IN=30m

# MinIO (internal Docker network only)
MINIO_BUCKET=lawyer-bucket
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_PUBLIC_URL=change-me

# Registry images (built in CI, pulled on deploy)
BACKEND_IMAGE=ghcr.io/youssef1129/portail-backend:latest
FRONTEND_IMAGE=ghcr.io/youssef1129/portail-frontend:latest

# Build-time only (CI): pass when building the frontend image
# NEXT_PUBLIC_API_URL=https://youssef-maazouz.stage2-div.rayan-drissi.com
